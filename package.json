{
  "name": "whatsapp-mcp-server",
  "version": "1.0.0",
  "description": "WhatsApp Model Context Protocol (MCP) Server to send and manage WhatsApp messages via AI agents",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "whatsapp-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "auth": "tsc && node dist/auth.js",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "whatsapp",
    "ai-agent",
    "baileys",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2"
  }
}
